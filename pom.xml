<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 4.0.7 — требует Java 17+, работает вплоть до Java 26 (F-10) -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.harness</groupId>
    <artifactId>harness</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Harness</name>
    <description>Учебный coding-агент на Spring AI</description>

    <properties>
        <!-- Java 25 — новейшая LTS: поддержка до сен-2030 против сен-2028 у Java 21 (F-14, F-15) -->
        <java.version>25</java.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <!-- Тесты, которым нужны живые Ollama или MCP-сервер. Обычный `mvnw test`
             их пропускает. Прогнать только их: mvnw test -Dgroups=ollama -Dexcluded.groups= -->
        <excluded.groups>ollama,mcp</excluded.groups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Ollama как источник модели. Spring AI 2.0.x работает с Boot 4.0.x/4.1.x (F-12) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-resolver-dns-native-macos</artifactId>
            <classifier>osx-aarch_64</classifier>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Без этого кириллица в консоли Windows превращается в «?????»:
                         JVM берёт stdout.encoding из кодовой страницы консоли, а не из file.encoding. -->
                    <jvmArguments>-Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</jvmArguments>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Spring AI 2.0 активно вычищает API 1.x. Без этих флагов
                         устаревшие вызовы компилируются молча, и узнаёшь о них,
                         когда метод удалят. -->
                    <showDeprecation>true</showDeprecation>
                    <compilerArgs>
                        <arg>-Xlint:deprecation</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>

                <configuration>
                    <excludedGroups>${excluded.groups}</excludedGroups>
                    <argLine>-javaagent:${org.mockito:mockito-core:jar} -Xshare:off -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
